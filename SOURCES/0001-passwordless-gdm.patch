+
+    test_ctx = talloc_new(NULL);
+    assert_non_null(test_ctx);
+
+    will_return(__wrap_json_array_append_new, false);
+    will_return(__wrap_json_array_append_new, false);
+    ret = json_format_auth_selection(test_ctx, true, PASSWORD_PROMPT,
+                                     true, OAUTH2_URI, OAUTH2_CODE,
