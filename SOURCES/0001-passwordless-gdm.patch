+        offset += str_len + 1;
+
+        DEBUG(SSSDBG_FUNC_DATA,
+              "cert_user %s, token_name %s, module_name %s, key_id %s,"
+              "label %s, prompt_str %s, pam_cert_user %s.\n",
+              cai->cert_user, cai->token_name, cai->module_name, cai->key_id,
