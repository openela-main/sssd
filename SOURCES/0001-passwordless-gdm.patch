new file mode 100644
index 000000000..442b37372
--- /dev/null
+++ b/src/tests/cmocka/test_sss_pam_data.c
@@ -0,0 +1,171 @@
+/*
+    SSSD
+
+    Unit test for sss_pam_data
+
+    Authors:
+        Iker Pedrosa <ipedrosa@redhat.com>
+
+    Copyright (C) 2024 Red Hat
