+            goto done;
+        }
+        offset += str_len + 1;
+
+        if (offset >= len[i]) {
+            DEBUG(SSSDBG_OP_FAILURE,
+                "Trying to access data outside of the boundaries.\n");
+            ret = EPERM;
+            goto done;
+        }
+
+        str_len = strnlen((const char *)sc[i] + offset, len[i] - offset);
